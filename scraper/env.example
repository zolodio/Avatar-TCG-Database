# ================================================================
#  AVATAR TCG — Price Scraper Environment Variables
#  Copy this file to:  scraper/.env   (never commit .env to git!)
# ================================================================

# ── eBay Developer App ID ─────────────────────────────────────────
# Free at: https://developer.ebay.com
# Sign in → My Account → Application Access Keys → Create App
# Copy the "App ID (Client ID)" for the PRODUCTION environment.
EBAY_APP_ID=YourApp-AvatarTCG-PRD-xxxxxxxx-xxxxxxxx

# ── Supabase ──────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Use the SERVICE ROLE key here (not the anon key).
# The service role key bypasses RLS so the scraper can write.
# Keep this secret — never put it in client-side code.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Scraper settings ──────────────────────────────────────────────
# How many eBay sold results to pull per card (max 100)
EBAY_RESULTS_PER_CARD=30

# Milliseconds to wait between eBay requests (be polite!)
DELAY_MS=800

# Default search prefix prepended to card names
PRICE_DEFAULT_PREFIX=Avatar TCG

# GitHub URL for the card CSV (used to get card names/numbers)
CSV_URL=https://raw.githubusercontent.com/zolodio/Avatar-TCG-Database/main/Extended%20Database.csv
